# ============================================================
# Real-Time ML Feature Engineering Pipeline — Environment Config
# Copy this file to .env and adjust values as needed.
# ============================================================

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# --- Topic Names ---
USER_EVENTS_TOPIC=user-events
CONTENT_METADATA_TOPIC=content-metadata
FEATURE_STORE_TOPIC=feature-store
FLINK_METRICS_TOPIC=flink-metrics

# --- Producer ---
# How many simulated-minutes pass per real second (60 = 1 hr of sim = 1 min real)
TIME_ACCELERATION=60
# Fraction of events that are deliberately late (0.07 = 7%)
LATE_EVENT_RATIO=0.07
# Min/max seconds in the past for late events (must cover 35-90s window)
LATE_EVENT_DELAY_MIN_SECONDS=35
LATE_EVENT_DELAY_MAX_SECONDS=90
# Number of simulated users and content items
NUM_USERS=20
NUM_CONTENT=50

# --- Flink ---
WATERMARK_SECONDS=30
FLINK_JOBMANAGER_URL=http://flink-jobmanager:8081

# --- Dashboard ---
DASHBOARD_PORT=8080
FLINK_JOB_MANAGER_URL=http://flink-jobmanager:8081
